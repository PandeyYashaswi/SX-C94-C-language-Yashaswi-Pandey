#include<stdio.h>
int main(){
    int n, num1=0, num2=1, nextnum;
    printf("YASHASHWI PANDEY\n");
    printf("enter number of finbonnaci series");
    scanf("%d",&n);
    printf("fibonacci series: ");
    for(int i=1; i<=n; ++i){
        nextnum =num1+num2;
        num1=num2;
        num2=nextnum;
        printf(" %d \n", num2);

    }
    return 0;
}
